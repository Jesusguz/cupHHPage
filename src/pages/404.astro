---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Not Found">
  <div class="flex items-center justify-center min-h-screen">
    <div class="text-center">
      <h1 class="text-6xl font-bold text-emerald-500 mb-4">404</h1>
      <p class="text-xl">Página no encontrada.</p>
      <a href="/" class="mt-8 inline-block px-6 py-2 bg-emerald-600 text-white rounded hover:bg-emerald-500">Volver al inicio</a>
    </div>
  </div>
</Layout>
