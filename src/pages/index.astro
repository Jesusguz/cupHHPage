---
// Prueba de conexión a la Base de Datos
const { DB } = Astro.locals.runtime.env;

let equipos = [];
let error = null;

try {
  const result = await DB.prepare("SELECT * FROM Equipos").all();
  equipos = result.results;
} catch (e) {
  error = e.message;
}
---

<html>
  <body>
    <h1>Prueba de Conexión D1</h1>
    {error && <p style="color:red">Error: {error}</p>}
    <pre>{JSON.stringify(equipos, null, 2)}</pre>
  </body>
</html>
